"help.toc" = "Mục lục";
"help.quickStart.title" = "Bắt đầu nhanh";
"help.quickStart.step1.title" = "Cấp quyền Full Disk Access";
"help.quickStart.step1.body" = "Mở Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Toàn quyền truy cập ổ đĩa, bật Clean My Mac. Không có quyền này, một số thư mục sẽ bị bỏ qua và kết quả không đầy đủ.";
"help.quickStart.step2.title" = "Bấm “Quét tất cả” (⌘R)";
"help.quickStart.step2.body" = "Các ổ trong được quét ngay. Nếu có ổ rời đang cắm, ứng dụng sẽ hỏi bạn muốn quét ổ nào. Bạn có thể huỷ quét bất cứ lúc nào (⌘.).";
"help.quickStart.step3.title" = "Xem Tóm tắt";
"help.quickStart.step3.body" = "Các mục được xếp theo mức độ: Nghiêm trọng, Cảnh báo, Gợi ý. Bấm “Xem” để đi tới thư mục, Docker hoặc danh sách trùng tên tương ứng.";
"help.quickStart.step4.title" = "Dọn dẹp an toàn";
"help.quickStart.step4.body" = "Mọi file xoá đều vào Thùng rác — khôi phục bằng “Đưa trở lại” trong Finder. Thư mục hệ thống được khoá, không thể xoá nhầm.";
"help.fullDiskAccess.title" = "Cấp quyền Full Disk Access";
"help.fullDiskAccess.body" = "macOS bảo vệ một số thư mục (Mail, Tin nhắn, Safari, dữ liệu của ứng dụng khác). Ứng dụng chỉ đọc được chúng khi có quyền Full Disk Access.\n\n1. Mở Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Toàn quyền truy cập ổ đĩa.\n2. Bật Clean My Mac (bấm “+” để thêm nếu chưa có trong danh sách).\n3. Quay lại ứng dụng và bấm “Kiểm tra lại”. Nếu vẫn “Chưa cấp”, hãy thoát và mở lại ứng dụng.\n\nClean My Mac chỉ đọc tên và dung lượng file. Không có dữ liệu nào được gửi ra ngoài.";
"help.scanning.title" = "Quét ổ trong & ổ rời";
"help.scanning.body" = "“Quét tất cả” quét ổ khởi động và các ổ trong khác. Ổ rời (USB, SSD, thẻ SD) được liệt kê trước và chỉ được quét sau khi bạn xác nhận — bạn có thể chọn từng ổ. Chọn “Ghi nhớ lựa chọn” để lần sau không hỏi lại (đổi lại trong Cài đặt).\n\nKhi bạn cắm ổ mới lúc ứng dụng đang mở, ứng dụng sẽ hỏi có muốn quét ổ đó không.\n\nDung lượng hiển thị là dung lượng thực chiếm trên đĩa. File hardlink chỉ tính một lần, symlink không bị đi theo và không quét lấn sang ổ khác, nên con số không bị thổi phồng.\n\nPhần “Dữ liệu hệ thống & không đọc được” trên thanh dung lượng là phần macOS dùng nhưng không liệt kê được: snapshot APFS, swap, thư mục hệ thống được bảo vệ.";
"help.severity.title" = "Đọc mức độ cảnh báo";
"help.severity.body" = "Mỗi mục có một mức độ để bạn biết việc nào cần làm trước.\n\nSSD chạy chậm khi gần đầy: macOS cần chỗ trống trên ổ khởi động cho bộ nhớ ảo (swap), cache, snapshot APFS và bản cập nhật hệ thống. Khi hết chỗ, ứng dụng bị treo và cập nhật thất bại.\n\nCác ngưỡng dưới đây có thể chỉnh trong Cài đặt.";
"help.severity.tableTitle" = "Mức dung lượng trống khuyến nghị";
"help.severity.critical" = "Ổ khởi động còn dưới %@, hoặc bất kỳ ổ nào còn dưới %@";
"help.severity.warning" = "Ổ khởi động còn dưới %@, hoặc bất kỳ ổ nào còn dưới %@";
"help.severity.ok" = "Trên các ngưỡng trên. Thư mục lớn có thể dọn được hiển thị dạng Gợi ý.";
"help.folders.title" = "Duyệt thư mục & Treemap";
"help.folders.body" = "Mở một ổ đĩa và chọn “Thư mục”. Danh sách được sắp xếp từ lớn đến nhỏ; treemap hiển thị các thư mục đó thành các ô có diện tích theo dung lượng.\n\nNháy đúp vào thư mục (trong danh sách hoặc treemap) để mở, dùng đường dẫn phía trên để quay lại. Chuột phải để Mở trong Finder, Xem nhanh và Chuyển vào Thùng rác.\n\n“Phân loại” hiển thị dung lượng theo mục đích (ứng dụng, ảnh, lập trình, cache…). “File lớn” liệt kê những file lớn nhất trên ổ.";
"help.duplicates.title" = "File trùng tên";
"help.duplicates.body" = "Sau khi quét, các file có cùng tên trên mọi ổ đã quét được gom thành nhóm. Tên được so sánh không phân biệt chữ hoa/thường và cách mã hoá dấu tiếng Việt.\n\nCác nhóm được sắp xếp theo dung lượng giải phóng được nếu chỉ giữ lại bản mới nhất. Mặc định bỏ qua node_modules, .git, thư mục build, gói ứng dụng, ~/Library và thư mục hệ thống, và bỏ qua file nhỏ hơn 1 MB.\n\nQuan trọng: trùng tên không có nghĩa là trùng nội dung. Hãy dùng Xem nhanh từng bản trước khi chuyển vào Thùng rác.";
"help.docker.title" = "Dọn Docker";
"help.docker.body" = "Trang Docker hoạt động theo từng bước:\n1. Máy đã cài Docker chưa? Nếu chưa, ứng dụng dừng lại và không chạy lệnh nào.\n2. Docker có đang chạy không? Nếu chưa, hãy mở Docker Desktop (hoặc OrbStack/Colima) rồi bấm “Kiểm tra lại”.\n3. Liệt kê image có tag <none> (dangling) — phần thừa sau khi build lại image, không container nào dùng.\n4. Xoá các image bạn chọn, sau khi xác nhận.\n\nImage được xoá không kèm --force, nên Docker sẽ từ chối xoá image vẫn đang được container sử dụng.\n\nVới Docker Desktop, file ổ ảo Docker.raw có thể không nhỏ lại ngay sau khi dọn.";
"help.deleting.title" = "Xoá & khôi phục file";
"help.deleting.body" = "Clean My Mac không bao giờ xoá vĩnh viễn. Mọi thứ đều vào Thùng rác (với ổ rời là Thùng rác riêng của ổ đó). Để khôi phục, mở Thùng rác, chuột phải vào file và chọn “Đưa trở lại”.\n\nThư mục hệ thống (/System, /Library, /usr…), thư mục người dùng, Documents, Desktop, Downloads, thư mục gốc của mỗi ổ và chính ứng dụng đều được khoá.\n\nNhật ký xoá liệt kê mọi thứ ứng dụng đã dọn. Dung lượng chỉ thực sự được giải phóng sau khi bạn dọn sạch Thùng rác.";
"help.faq.title" = "Câu hỏi thường gặp";
"help.faq.body" = "Vì sao tổng dung lượng khác với “Giới thiệu về máy Mac này”?\nmacOS tính cả snapshot APFS, swap và dung lượng có thể giải phóng (purgeable) — những phần không liệt kê được thành file. Chúng được hiển thị là “Dữ liệu hệ thống & không đọc được”.\n\nVì sao một số thư mục bị khoá?\nChúng được macOS bảo vệ. Hãy cấp Full Disk Access, hoặc đó là thư mục hệ thống không nên đụng vào.\n\nmacOS báo ứng dụng đến từ nhà phát triển không xác định?\nNếu bạn tự build, ứng dụng được ký cục bộ. Mở Cài đặt hệ thống › Quyền riêng tư & Bảo mật và bấm “Vẫn mở”.\n\nHỗ trợ phiên bản macOS nào?\nmacOS 13 Ventura trở lên, trên cả máy Apple silicon và Intel.";
