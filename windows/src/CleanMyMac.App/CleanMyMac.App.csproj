<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 version 1809 (build 17763) and later. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>CleanMyMac</RootNamespace>
    <AssemblyName>CleanMyMac</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Unpackaged + self-contained: a plain folder/installer, no Store or runtime installs needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Lets `dotnet build/publish` work without Visual Studio: packaging tasks come from the NuGet package. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskKit.Core\DiskKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared translations from the macOS app, plus Windows-specific overrides. -->
    <EmbeddedResource Include="..\..\..\App\Resources\en.lproj\Localizable.strings" LogicalName="Strings.en.base" />
    <EmbeddedResource Include="..\..\..\App\Resources\vi.lproj\Localizable.strings" LogicalName="Strings.vi.base" />
    <EmbeddedResource Include="Strings\en.strings" LogicalName="Strings.en.windows" />
    <EmbeddedResource Include="Strings\vi.strings" LogicalName="Strings.vi.windows" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
