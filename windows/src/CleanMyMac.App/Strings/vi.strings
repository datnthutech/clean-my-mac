"win.help.quickStart.step1.title" = "Tuỳ chọn: khởi động lại với quyền Admin";
"win.help.quickStart.step1.body" = "Với tài khoản thường, một số thư mục hệ thống sẽ bị bỏ qua. Quyền Admin cho kết quả đầy đủ; các tính năng khác vẫn dùng bình thường.";
"win.help.quickStart.step2.title" = "Bấm “Quét tất cả”";
"win.help.quickStart.step2.body" = "Các ổ trong được quét ngay. Nếu có USB hoặc thẻ nhớ đang cắm, ứng dụng sẽ hỏi bạn muốn quét ổ nào. Bạn có thể huỷ quét bất cứ lúc nào.";
"win.help.quickStart.step3.title" = "Xem Tóm tắt";
"win.help.quickStart.step3.body" = "Các mục được xếp theo mức độ: Nghiêm trọng, Cảnh báo, Gợi ý. Bấm “Xem” để đi tới thư mục, Docker hoặc danh sách trùng tên tương ứng.";
"win.help.quickStart.step4.title" = "Dọn dẹp an toàn";
"win.help.quickStart.step4.body" = "Mục bị xoá sẽ vào Thùng rác và có thể khôi phục. Windows, Program Files, thư mục cá nhân và thư mục gốc của các ổ đều được khoá.";
"win.help.admin.title" = "Quyền Admin";
"win.help.admin.body" = "Windows bảo vệ một số thư mục (Windows, hồ sơ của người dùng khác, System Volume Information). Tài khoản thường không liệt kê được nên các thư mục này bị bỏ qua và tổng dung lượng trông nhỏ hơn thực tế.\n\nBấm “Khởi động lại với quyền Admin” và đồng ý ở hộp thoại của Windows. Ứng dụng mở lại với toàn quyền. Ứng dụng chỉ đọc tên và dung lượng file — không gửi dữ liệu đi đâu cả.";
"win.help.scanning.title" = "Quét ổ trong & ổ rời";
"win.help.scanning.body" = "“Quét tất cả” quét ổ cài Windows và các ổ trong khác. USB, SSD gắn ngoài và thẻ nhớ được liệt kê trước và chỉ được quét sau khi bạn xác nhận — tick chọn ổ muốn quét. “Ghi nhớ lựa chọn” để lần sau không hỏi lại (đổi trong Cài đặt).\n\nKhi bạn cắm ổ mới lúc ứng dụng đang mở, ứng dụng sẽ hỏi có muốn quét ổ đó không.\n\nDung lượng hiển thị là dung lượng thực chiếm trên đĩa (“Size on disk”). Hard link (rất nhiều trong Windows\\WinSxS) chỉ tính một lần; junction, symbolic link và thư mục gắn ổ không bị đi theo, nên con số không bị thổi phồng.";
"win.help.folders.body" = "Mở một ổ đĩa và chọn “Thư mục”. Danh sách được sắp xếp từ lớn đến nhỏ; treemap hiển thị các mục đó thành các ô có diện tích theo dung lượng.\n\nNháy đúp vào thư mục để mở, dùng đường dẫn phía trên để quay lại. Chọn mục (giữ Ctrl/Shift để chọn nhiều) rồi dùng Mở trong Explorer, Mở hoặc Chuyển vào Thùng rác.\n\n“Phân loại” hiển thị dung lượng theo mục đích (ứng dụng, ảnh, lập trình, cache…). “File lớn” liệt kê những file lớn nhất trên ổ.";
"win.help.docker.title" = "Dọn Docker";
"win.help.docker.body" = "Trang Docker hoạt động theo từng bước:\n1. Máy đã cài Docker chưa? Nếu chưa, ứng dụng dừng lại và không chạy lệnh nào.\n2. Docker có đang chạy không? Nếu chưa, hãy mở Docker Desktop rồi bấm “Kiểm tra lại”.\n3. Liệt kê image có tag <none> (dangling) — phần thừa sau khi build lại image, không container nào dùng.\n4. Xoá các image bạn chọn, sau khi xác nhận.\n\nImage được xoá không kèm --force, nên Docker sẽ từ chối xoá image vẫn đang được container sử dụng.\n\nDocker Desktop lưu mọi thứ trong ổ ảo WSL 2 (.vhdx). File này không tự nhỏ lại sau khi dọn.";
"win.help.deleting.title" = "Xoá & khôi phục file";
"win.help.deleting.body" = "Clean My Mac chuyển file vào Thùng rác. Để khôi phục, mở Thùng rác, chuột phải vào file và chọn “Khôi phục”.\n\nUSB và thẻ nhớ không có Thùng rác. Với các mục trên những ổ này, ứng dụng cảnh báo rõ ràng và hỏi trước khi xoá vĩnh viễn.\n\nWindows, Program Files, ProgramData, thư mục cá nhân (Desktop, Documents, Downloads, AppData), thư mục gốc của mỗi ổ và chính ứng dụng đều được khoá.\n\nNhật ký xoá liệt kê mọi thứ ứng dụng đã dọn. Dung lượng chỉ thực sự được giải phóng sau khi bạn dọn sạch Thùng rác.";
"win.help.faq.title" = "Câu hỏi thường gặp";
"win.help.faq.body" = "Vì sao tổng dung lượng khác với dung lượng đã dùng của ổ?\nWindows tính cả điểm khôi phục, dữ liệu NTFS và các thư mục tài khoản thường không đọc được. Chúng được hiển thị là “Dữ liệu hệ thống & không đọc được”.\n\nWindows SmartScreen cảnh báo khi cài đặt?\nBản build chưa được ký bằng chứng chỉ thương mại. Bấm “Thông tin thêm” › “Vẫn chạy”.\n\nHỗ trợ phiên bản Windows nào?\nWindows 10 phiên bản 1809 trở lên và Windows 11, trên máy x64 và ARM64.\n\nỨng dụng có dùng mạng không?\nKhông.";
